[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Main.gd" id="1_main"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.07, 0.09, 1)

[node name="UI" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="UI"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = 32.0
offset_right = -32.0
offset_bottom = -32.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="UI/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="UI/Margin/VBox"]
layout_mode = 2
text = "AdMob Starter"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 34

[node name="Info" type="Label" parent="UI/Margin/VBox"]
layout_mode = 2
text = "Godot 4.7 • Test Ads"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20

[node name="Status" type="Label" parent="UI/Margin/VBox"]
layout_mode = 2
text = "Starting..."
horizontal_alignment = 1
autowrap_mode = 2
theme_override_font_sizes/font_size = 20

[node name="LoadBanner" type="Button" parent="UI/Margin/VBox"]
layout_mode = 2
text = "Load / Refresh Banner"
custom_minimum_size = Vector2(0, 70)

[node name="LoadInterstitial" type="Button" parent="UI/Margin/VBox"]
layout_mode = 2
text = "Load Interstitial"
custom_minimum_size = Vector2(0, 70)

[node name="ShowInterstitial" type="Button" parent="UI/Margin/VBox"]
layout_mode = 2
text = "Show Interstitial"
custom_minimum_size = Vector2(0, 70)

[node name="LoadRewarded" type="Button" parent="UI/Margin/VBox"]
layout_mode = 2
text = "Load Rewarded"
custom_minimum_size = Vector2(0, 70)

[node name="ShowRewarded" type="Button" parent="UI/Margin/VBox"]
layout_mode = 2
text = "Show Rewarded"
custom_minimum_size = Vector2(0, 70)

[node name="Reward" type="Label" parent="UI/Margin/VBox"]
layout_mode = 2
text = "Reward received: 0"
horizontal_alignment = 1
autowrap_mode = 2
theme_override_font_sizes/font_size = 20

[node name="Note" type="Label" parent="UI/Margin/VBox"]
layout_mode = 2
text = "These are Google's official test ad IDs. Do not replace them with real IDs until your AdMob app is ready."
horizontal_alignment = 1
autowrap_mode = 2

[connection signal="pressed" from="UI/Margin/VBox/LoadBanner" to="." method="_on_load_banner_pressed"]
[connection signal="pressed" from="UI/Margin/VBox/LoadInterstitial" to="." method="_on_load_interstitial_pressed"]
[connection signal="pressed" from="UI/Margin/VBox/ShowInterstitial" to="." method="_on_show_interstitial_pressed"]
[connection signal="pressed" from="UI/Margin/VBox/LoadRewarded" to="." method="_on_load_rewarded_pressed"]
[connection signal="pressed" from="UI/Margin/VBox/ShowRewarded" to="." method="_on_show_rewarded_pressed"]
